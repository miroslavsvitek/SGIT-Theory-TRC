      9
    ],
    "evidence": "R2 behavior-only marker audit, no TRC/neural outcome computed",
    "validation": {
      "target_sets_must_be_top3_by_response_rate": true,
      "minimum_selected_target_rate": 0.7,
      "minimum_rank_gap_third_vs_fourth": 0.25,
      "absolute_nontarget_rate_gate_removed": true,
      "reason": "phase-3 flipped stimuli can attract responses after SWS learning; this does not make stimulus identity ambiguous"
    },
    "one_back_trials_excluded_from_neural_analysis": true
  },
  "channel_transport": {
    "primary_file": "support/MONTAGE60_TEMPLATE_TRANSPORT_R4.json",
    "method": "published_figure_template_4NN_IDW2",
    "source_sites_used": "raw channels 1..95",
    "source_channel_96": "excluded_from_spatial_transport_only; retained in common-average/artifact preprocessing",
    "target": "frozen named 64-channel system",
    "condition_blind": true,
    "label_blind": true,
    "neural_outcome_blind": true,
    "quality_gate_median_nearest_px_max": 30.0,
    "quality_gate_max_nearest_px_max": 60.0,
    "interpretation": "template-transport external no-report test; PASS is supportive, FAIL cannot by itself prove exact frozen-montage falsification"
