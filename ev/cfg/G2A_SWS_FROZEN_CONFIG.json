      34,
      39,
      45,
      51,
      56,
      62
    ]
  },
  "edge_flow": {
    "lag_samples": 1,
    "epsilon": 1e-12
  },
  "windows_ms": [
    [
      80.0,
      240.0
    ],
    [
      240.0,
      400.0
    ],
    [
      400.0,
      560.0
    ]
  ],
  "S3_axis": [
    0.998756755,
    -0.049849216
  ],
  "pair_preserving": {
    "families": [
      "N12|3",
      "N13|2",
      "N23|1"
    ],
    "permutations_per_family": 1024
  },
  "group_test": {
    "alpha_one_sided": 0.025,
    "mc_signflips": 99999,
    "seed": 20261007
  },
  "primary_pass": "N>=15 AND median(Delta_PP_SWS)>0 AND p_SWS<=0.025 AND median(D_control)>0 AND p_control<=0.025",
  "D_control": "Delta_PP_SWS - Delta_PP_FLIPPED",
  "interpretation": "Existing-data report-independent transfer. Positive result supports report-independence of TRC but does not establish causal necessity.",
  "adapter_revision": "R4_PUBLISHED_MONTAGE60_TEMPLATE_TRANSPORT",
  "science_constants_changed_from_v1_0": false,
  "download_filter": {
    "include": [
      "/Behavior (all groups).csv",
      "/Behavior_17_included_subjs.xlsx",
      "/Raw_EEG_17_included_subjs/"
    ],
    "exclude": [
      "/Raw_EEG_13_excluded_subjs/"
    ],
    "reuse_partial_download": true,
    "preferred_root": "E:\\SGIT_DATA\\SGIT_G2A_SWS_DSMJP"
  },
  "event_decoder": {
