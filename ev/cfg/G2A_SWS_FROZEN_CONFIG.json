  },
  "scientific_claim": "Report-independent conscious-content transfer test",
  "primary_contrast": {
    "C": "phase 2 SWS: task-irrelevant, perceived as speech",
    "U": "phase 1 SWS: task-irrelevant, perceived as noise",
    "physical_stimulus": "identical SWS tokens",
    "control": "flipped SWS phase2 vs phase1; perceived as noise in both phases"
  },
  "behavioral_gate": {
