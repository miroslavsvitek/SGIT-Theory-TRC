      800.0
    ],
    "artifact_peak_abs_uv": 70.0,
    "baseline_ms": [
      -200.0,
      0.0
    ],
    "exclude_one_back": true,
    "continuous_lowpass_hz": 25.0,
    "continuous_average_reference": true,
    "artifact_gate_applied_on_source_96_before_transport": true
  },
  "hodge": {
    "N": 64,
    "E": 222,
    "T": 216,
    "curl_indices_zero_based": [
      0,
      14,
      28,
      41,
      55,
      69,
      83,
      97,
      111,
      124,
      138,
      152
