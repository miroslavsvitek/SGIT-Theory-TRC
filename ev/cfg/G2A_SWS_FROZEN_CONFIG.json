{
  "experiment_id": "SGIT_G2A_SWS_NOREPORT_TRANSFER",
  "version": "1.0",
  "source": {
    "study": "Zhu et al. 2024, J Neurosci",
    "doi": "10.1523/JNEUROSCI.0145-23.2023",
    "osf_node": "dsmjp",
